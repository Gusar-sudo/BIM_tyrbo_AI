# -*- coding: utf-8 -*-
# Только чтение: горизонтальные сечения у вертикальных импостов (фильтр по имени типа) — контуры стекла и уплотнителя
# соседних панелей в координатах импоста (X вдоль стены, Y поперёк) + семейство профиля и отражение графики.
# Для подгонки сечения уплотнителя под паз держателя. Аргументы: type_like (подстроки через пробел), max_per_type=1, half_mm=60, out_json
import json, io
from Autodesk.Revit.DB import *
args = json.loads(HORIZUN_ARGS_JSON)
doc = __revit__.ActiveUIDocument.Document
FT = 304.8
opt = Options(); opt.DetailLevel = ViewDetailLevel.Fine
like = args.get("type_like", u"").lower().split()
HALF = args.get("half_mm", 60) / FT
seen = {}; recs = []


def mat_of(s):
    for f in s.Faces:
        m = doc.GetElement(f.MaterialElementId)
        if m: return m.Name
    return u""


def cut_loops(e, org, d, n, z):
    pl = Plane.CreateByNormalAndOrigin(XYZ.BasisZ, XYZ(org.X, org.Y, z))
    out = []
    def walk(g):
        for o in g:
            if isinstance(o, Solid) and o.Volume > 1e-12:
                bb = o.GetBoundingBox(); tr = bb.Transform; lo = tr.OfPoint(bb.Min); hi = tr.OfPoint(bb.Max)
                if min(lo.Z, hi.Z) > z or max(lo.Z, hi.Z) < z: continue
                c = (lo + hi) / 2
                if abs((c - org).DotProduct(d)) > HALF + abs((hi - lo).DotProduct(d)) / 2: continue
                m = mat_of(o)
                if not (u"Стекл" in m or u"Уплотн" in m): continue
                try: s = BooleanOperationsUtils.CutWithHalfSpace(o, pl)
                except Exception: continue
                if s is None: continue
                for f in s.Faces:
                    if isinstance(f, PlanarFace) and abs(f.FaceNormal.Z) > 0.99:
                        vz = [v.Z for v in f.Triangulate().Vertices]
                        if max(abs(q - z) for q in vz) > 1e-4: continue
                        loops = []
                        for cl in f.GetEdgesAsCurveLoops():
                            pts = []
                            for cv in cl:
                                for p in cv.Tessellate()[:-1]:
                                    v = p - XYZ(org.X, org.Y, z); pts.append([round(v.DotProduct(d) * FT, 3), round(v.DotProduct(n) * FT, 3)])
                            loops.append(pts)
                        out.append({"mat": m, "loops": loops})
            elif isinstance(o, GeometryInstance):
                walk(o.GetInstanceGeometry())
    g = e.get_Geometry(opt)
    if g: walk(g)
    return out


for w in FilteredElementCollector(doc).OfClass(Wall):
    if w.CurtainGrid is None: continue
    lc = w.Location.Curve
    d = lc.Direction; d = XYZ(d.X, d.Y, 0).Normalize(); n = XYZ(-d.Y, d.X, 0)
    for mid in w.CurtainGrid.GetMullionIds():
        m = doc.GetElement(mid)
        nm = m.Name
        if not all(k in nm.lower() for k in like): continue
        if m.LocationCurve is None or abs(m.LocationCurve.Direction.Z) < 0.9: continue
        if seen.get(nm, 0) >= int(args.get("max_per_type", 1)): continue
        prof = doc.GetElement(m.MullionType.get_Parameter(BuiltInParameter.MULLION_PROFILE).AsElementId())
        p0 = m.LocationCurve.GetEndPoint(0); p1 = m.LocationCurve.GetEndPoint(1)
        z = (p0.Z + p1.Z) / 2; org = XYZ(p0.X, p0.Y, z)
        items = []
        for pid in w.CurtainGrid.GetPanelIds():
            p = doc.GetElement(pid)
            items += cut_loops(p, org, d, n, z)
        if not any(u"Уплотн" in it["mat"] for it in items): continue
        seen[nm] = seen.get(nm, 0) + 1
        recs.append({"mullion_type": nm, "profile": prof.Family.Name if prof else None, "wall": w.Name, "items": items})
io.open(args["out_json"], "w", encoding="utf-8").write(json.dumps(recs, ensure_ascii=False))
__output__ = {"status": "completed_unverified", "summary": u"сечений %d" % len(recs), "types": sorted(seen.keys())}
