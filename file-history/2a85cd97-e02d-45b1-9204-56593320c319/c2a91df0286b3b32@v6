            vr = v.GetViewRange(); vr.SetOffset(PlanViewPlane.CutPlane, 500 / FT); v.SetViewRange(vr)
            bx = BoundingBoxXYZ(); bx.Min = XYZ(ox - H, oy - H, -1000); bx.Max = XYZ(ox + H, oy + H, 1000)
            v.CropBox = bx; v.CropBoxActive = True; v.CropBoxVisible = False
