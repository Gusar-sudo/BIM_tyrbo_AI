def _segd(px, py, s):
    ax_, ay, bx, by = s; dx, dy = bx - ax_, by - ay; L = dx * dx + dy * dy
    t = 0.0 if L == 0 else max(0.0, min(1.0, ((px - ax_) * dx + (py - ay) * dy) / L))
    return ((px - ax_ - t * dx) ** 2 + (py - ay - t * dy) ** 2) ** 0.5


def fit_profile(k):
    # 2D-положение профиля в мире: одна из 8 ориентаций в осях стены-хозяина (направление e1, нормаль e2), начало — ось импоста
    if k["id"] in _fit:
        return _fit[k["id"]]
    m = doc.GetElement(ElementId(k["id"])); own = OTH[k["tname"]]["own"]
    w = m.Host; e1 = w.Location.Curve.Direction; e1 = XYZ(e1.X, e1.Y, 0).Normalize(); e2 = XYZ(-e1.Y, e1.X, 0)
    p0 = k["c"].GetEndPoint(0); pts = []
    def walk(ge):
        for g in ge:
            if isinstance(g, Solid) and g.Volume > 1e-9:
                for e in g.Edges:
                    for q in e.Tessellate():
                        v = q - p0; pts.append((v.DotProduct(e1) * FT, v.DotProduct(e2) * FT))
            elif isinstance(g, GeometryInstance):
                walk(g.GetInstanceGeometry())
    o = Options(); o.DetailLevel = ViewDetailLevel.Fine; walk(m.get_Geometry(o))
    pts = pts[::max(1, len(pts) // 150)]
    ox0 = min(min(s[0], s[2]) for s in own); ox1 = max(max(s[0], s[2]) for s in own)
    oy0 = min(min(s[1], s[3]) for s in own); oy1 = max(max(s[1], s[3]) for s in own)
    best = None
    # x профиля = направление стены (Revit кладёт вертикальный импост без зеркала по x) — перебор только знака y;
    # перебор зеркал давал ложное совпадение (точки почти все на наружном контуре), урок 14.11
    for sw in (False,):
        for sx in (1.0,):
            for sy in (1.0, -1.0):
                rot = (lambda a, b, sw=sw, sx=sx, sy=sy: (b * sy, a * sx) if sw else (a * sx, b * sy))
                q = [rot(a, b) for a, b in pts]
                # сдвиг: у концевых импостов профиль смещён от линии импоста — совмещаем рамки
                shx = (ox0 + ox1) / 2 - (min(x for x, y in q) + max(x for x, y in q)) / 2
                shy = (oy0 + oy1) / 2 - (min(y for x, y in q) + max(y for x, y in q)) / 2
                for hx, hy in ((0.0, 0.0), (shx, shy)):
                    sc = sum(min(_segd(x + hx, y + hy, s) for s in own) for x, y in q) / max(1, len(q))
                    if best is None or sc < best[0] - 1e-6:
                        best = (sc, sw, sx, sy, hx, hy)
    sc, sw, sx, sy, shx, shy = best

    def inv(a, b):   # мир (a,b) от линии импоста -> профиль (x,y)
        x, y = (b * sy, a * sx) if sw else (a * sx, b * sy)
        return (x + shx, y + shy)

    def fwd(x, y):   # профиль -> мир (a,b) от линии импоста
        x, y = x - shx, y - shy
        return (y * sx, x * sy) if sw else (x * sx, y * sy)
    def dinv(a, b):   # направление мир -> профиль (без сдвига!)
        return (b * sy, a * sx) if sw else (a * sx, b * sy)

    def dfwd(x, y):   # направление профиль -> мир (без сдвига!)
        return (y * sx, x * sy) if sw else (x * sx, y * sy)
    oa, ob = fwd(0.0, 0.0)
    org = p0 + e1 * (oa / FT) + e2 * (ob / FT)   # начало профиля в мире
    _fit[k["id"]] = {"score": sc, "inv": inv, "fwd": fwd, "dinv": dinv, "dfwd": dfwd, "e1": e1, "e2": e2, "p0": p0, "org": org, "shift": (round(shx, 2), round(shy, 2))}
    return _fit[k["id"]]


def _hit(segs, lat):
    best = None
    for s in segs:
        if (s[1] - lat) * (s[3] - lat) > 0 or s[1] == s[3]:
            continue
        v = s[0] + (lat - s[1]) / (s[3] - s[1]) * (s[2] - s[0])
        if v < 0 and (best is None or v < best):
            best = v
    return best


def side_ref(k, side, bands):
    # bands — полосы стекол [(lo, hi)] в поперечной координате стороны; вернуть (точка отсчёта, способ)
    f = SIDEMAP[side]; r = OTH[k["tname"]]
    nest = [f(s[0], s[1]) + f(s[2], s[3]) for s in r["nested"]]
    own = [f(s[0], s[1]) + f(s[2], s[3]) for s in r["own"]]
    outer = -min(min(s[0], s[2]) for s in own)
    hit = None
    for lo, hi in bands:
        lat = lo + 0.3
        while lat <= hi - 0.3 + 1e-9:
            v = _hit(nest, lat)
            if v is not None and -v <= outer - 1.0 and (hit is None or -v > hit):
                hit = -v
            lat += 0.25
    if hit is None:
        return None, u"паз не найден"
    if k["code"] in BEND_CODES:
        bend = None
        for s in nest:
            for x, y in ((s[0], s[1]), (s[2], s[3])):
                dep = -x
                if not (hit < dep <= hit + 7.0):
                    continue
                for lo, hi in bands:
                    dd = (lo - y) if y < lo else ((y - hi) if y > hi else -1)
                    if 2.5 <= dd <= 5.5 and (bend is None or dep > bend):
                        bend = dep
        if bend is not None:
            return bend, u"от начала изгиба"
        return hit, u"изгиб не найден — по первому касанию"
    return hit, u"дно паза"


def glass_bands(pn, k, side):
    ft = fit_profile(k); p0 = ft["p0"]; bands = []
    def walk(ge):
        for g in ge:
            if isinstance(g, Solid) and g.Volume > 1e-9 and g.Faces.Size:
                mt_ = doc.GetElement(g.Faces.get_Item(0).MaterialElementId)
                if mt_ is not None and u"Стекло" in mt_.Name:
                    ls = []
                    for e in g.Edges:
                        for q in e.Tessellate():
                            v = q - p0; x, y = ft["inv"](v.DotProduct(ft["e1"]) * FT, v.DotProduct(ft["e2"]) * FT)
                            ls.append(y if side in ("-X", "+X") else x)
                    bands.append((min(ls), max(ls)))
            elif isinstance(g, GeometryInstance):
                walk(g.GetInstanceGeometry())
    o = Options(); o.DetailLevel = ViewDetailLevel.Fine; walk(pn.get_Geometry(o))
    return bands


class LO(IFamilyLoadOptions):
    def OnFamilyFound(self, a, b):
        b.Value = True; return True

    def OnSharedFamilyFound(self, s, a, src, b):
        src.Value = FamilySource.Family; b.Value = True; return True


def glass_u(pn, d_):
    us = []
    def walk(ge):
        for g in ge:
            if isinstance(g, Solid) and g.Volume > 1e-9 and g.Faces.Size:
                m = doc.GetElement(g.Faces.get_Item(0).MaterialElementId)
                if m is not None and u"Стекло" in m.Name:
                    for e in g.Edges:
                        for q in e.Tessellate():
                            us.append(q.X * d_.X + q.Y * d_.Y)
            elif isinstance(g, GeometryInstance):
                walk(g.GetInstanceGeometry())
    o = Options(); o.DetailLevel = ViewDetailLevel.Fine
    walk(pn.get_Geometry(o))
    return (min(us), max(us)) if us else None


