import json, math, sys, re
src = open(sys.argv[2], encoding="utf-8").read()
# РІС‹С‚Р°С‰РёС‚СЊ С„СѓРЅРєС†РёРё arc3, chain, area, holder_loop
ns = {"math": math}
for name in ("chain", "area", "arc3", "holder_loop"):
    m = re.search(r"^def %s\(.*?(?=^\S)" % name, src, re.S | re.M)
    exec(m.group(0), ns)
ns["HSEG"] = json.load(open(sys.argv[1], encoding="utf-8"))["segs"]
segs = []
for s in ns["HSEG"]:
    if s[0] == "L":
        segs.append(((s[1], s[2]), (s[3], s[4])))
    else:
        ps = ns["arc3"](s[1:3], s[3:5], s[5:7])
        segs += [(ps[i], ps[i + 1]) for i in range(len(ps) - 1)]
print("subsegs", len(segs))
l = ns["chain"](segs, 0.005)
print("loops", len(l), [len(x) for x in l])
# check arc endpoints
for s in ns["HSEG"]:
    if s[0] == "A":
        ps = ns["arc3"](s[1:3], s[3:5], s[5:7])
        e = math.hypot(ps[0][0]-s[1], ps[0][1]-s[2])
        if e > 0.01: print("arc start off", e, s)

big = 0
for s in ns["HSEG"]:
    if s[0] == "A":
        ps = ns["arc3"](s[1:3], s[3:5], s[5:7])
        if len(ps) > 10: big += 1; print("big arc", len(ps), s)
print("big", big)
