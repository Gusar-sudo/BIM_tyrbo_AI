# Вырезки вертикальных сечений из альбомов М2 (image69, image70) и М3 (image83, image84) -> review\album_vertical
Add-Type -AssemblyName System.Drawing
$root = Split-Path -Parent (Split-Path -Parent $PSScriptRoot)
$out = Join-Path $root 'review\album_vertical'
New-Item -ItemType Directory -Force $out | Out-Null
function Crop($src, $dst, $x0, $y0, $x1, $y1, $rot) {
    $b = [System.Drawing.Image]::FromFile($src)
    $W = $b.Width; $H = $b.Height
    $r = New-Object System.Drawing.Rectangle ([int]($x0 * $W)), ([int]($y0 * $H)), ([int](($x1 - $x0) * $W)), ([int](($y1 - $y0) * $H))
    $c = New-Object System.Drawing.Bitmap $r.Width, $r.Height
    $g = [System.Drawing.Graphics]::FromImage($c); $g.Clear([System.Drawing.Color]::White)
    $g.DrawImage($b, (New-Object System.Drawing.Rectangle 0, 0, $r.Width, $r.Height), $r, [System.Drawing.GraphicsUnit]::Pixel)
    $b.Dispose()
    if ($rot) { $c.RotateFlip([System.Drawing.RotateFlipType]::Rotate90FlipNone) }
    $c.SetResolution(300, 300)
    $c.Save($dst, [System.Drawing.Imaging.ImageFormat]::Png); $c.Dispose()
    "$dst"
}
$m2 = Join-Path $root 'review\album_m2_media'; $m3 = Join-Path $root 'review\album_m3_media'
Crop "$m2\image69.png" "$out\M2_рис32_глухая.png" 0 0 0.5 1 $false
Crop "$m2\image69.png" "$out\M2_рис33_одинарное.png" 0.5 0 1 1 $false
Crop "$m2\image70.png" "$out\M2_рис35_комбинированная.png" 0 0 1 0.42 $true
Crop "$m2\image70.png" "$out\M2_рис34_двойное.png" 0 0.5 1 1 $true
Crop "$m3\image83.png" "$out\M3_рис38_глухая.png" 0 0 0.5 1 $false
Crop "$m3\image83.png" "$out\M3_рис39_одинарное.png" 0.5 0 1 1 $false
Crop "$m3\image84.png" "$out\M3_рис41_комбинированная.png" 0 0 1 0.42 $true
Crop "$m3\image84.png" "$out\M3_рис40_двойное.png" 0 0.5 1 1 $true
