"""Типы объектов, чья опорная точка/габарит попадает в окно. py dxf_window_types.py <dxf> x0,y0,x1,y1"""
import sys, ezdxf, collections
from ezdxf import bbox
sys.stdout.reconfigure(encoding="utf-8")
doc = ezdxf.readfile(sys.argv[1]); x0, y0, x1, y1 = [float(v) for v in sys.argv[2].split(",")]
cnt = collections.Counter(); ins = []
for e in doc.modelspace():
    try:
        b = bbox.extents([e], fast=True)
        if not b.has_data: continue
        if b.extmax.x < x0 or b.extmin.x > x1 or b.extmax.y < y0 or b.extmin.y > y1: continue
    except Exception as ex:
        continue
    cnt[(e.dxftype(), e.dxf.layer)] += 1
    if e.dxftype() == "INSERT":
        ins.append((e.dxf.name, round(e.dxf.insert.x, 1), round(e.dxf.insert.y, 1), round(e.dxf.xscale, 3), round(e.dxf.rotation, 1), [round(v, 1) for v in (b.extmin.x, b.extmin.y, b.extmax.x, b.extmax.y)]))
for k, v in cnt.most_common(): print(k, v)
for i in ins[:40]: print("INSERT", i)
