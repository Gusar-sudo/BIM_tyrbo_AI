import json, sys
import matplotlib; matplotlib.use("Agg")
import matplotlib.pyplot as plt
D = json.load(open(sys.argv[1], encoding="utf-8"))
ns = sorted(D.keys())
fig, axs = plt.subplots(2, 3, figsize=(21, 14))
for ax, n in zip(axs.ravel(), ns):
    r = D[n]
    for s in r["nested"]: ax.plot([s[0], s[2]], [s[1], s[3]], color="0.55", lw=0.7)
    for s in r["own"]: ax.plot([s[0], s[2]], [s[1], s[3]], color="red", lw=1.3)
    ax.axhspan(-35.7, -25.7, color="tab:cyan", alpha=0.2); ax.axhspan(-35.7, -30.7, color="tab:blue", alpha=0.15)
    ax.set_xlim(-45, 45); ax.set_ylim(-50, 10); ax.set_aspect("equal"); ax.grid(lw=0.2)
    ax.set_xticks(range(-44, 46, 4)); ax.set_yticks(range(-50, 11, 2)); ax.tick_params(labelsize=5)
    ax.set_title(n + "\n" + r["family"].replace("BIMLIB_Профиль_", ""), fontsize=8)
fig.savefig(sys.argv[2], dpi=130, bbox_inches="tight")
