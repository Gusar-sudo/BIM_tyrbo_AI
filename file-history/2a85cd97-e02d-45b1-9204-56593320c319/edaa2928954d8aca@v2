import json, sys
import matplotlib; matplotlib.use("Agg")
import matplotlib.pyplot as plt
D = json.load(open(sys.argv[1], encoding="utf-8"))
ns = sorted(D.keys())
fig, axs = plt.subplots(2, 2, figsize=(18, 18))
for ax, n in zip(axs.ravel(), ns):
    r = D[n]
    for s in r["nested"]: ax.plot([s[0], s[2]], [s[1], s[3]], color="0.55", lw=0.7)
    for s in r["own"]: ax.plot([s[0], s[2]], [s[1], s[3]], color="red", lw=1.3)
    ax.set_xlim(-110, 110); ax.set_ylim(-110, 110); ax.set_aspect("equal"); ax.grid(lw=0.2)
    ax.set_xticks(range(-110, 111, 10)); ax.set_yticks(range(-110, 111, 10)); ax.tick_params(labelsize=6)
    ax.axhline(0, lw=0.4, color="k"); ax.axvline(0, lw=0.4, color="k")
    ax.set_title(n + "\n" + r["family"].replace("BIMLIB_Профиль_", ""), fontsize=9)
fig.savefig(sys.argv[2], dpi=110, bbox_inches="tight")
