# -*- coding: utf-8 -*-
# Проба цвета на одном узле С ОТКАТОМ (группа транзакций RollBack): картинки «было» и «стало».
# Виды: план узла (Coarse / Medium / Fine) и 3D с секущим кубом (Скрытые линии / Тонированный / Реалистичный, Fine).
# «Стало»: загрузить копии .rfa (rfas) и задать материалам цвета (materials: {имя: {shade, cut, transp}}).
# Аргументы: mullion_type_like, rfas [], materials {}, out_dir, half_len_mm (150), px (1400), scale (2)
import json, io, os, re, glob
from System.Collections.Generic import List
from Autodesk.Revit.DB import *
args = json.loads(HORIZUN_ARGS_JSON)
doc = __revit__.ActiveUIDocument.Document
FT = 304.8
OUT = args["out_dir"]
if not os.path.isdir(OUT):
    os.makedirs(OUT)
like = args.get("mullion_type_like", u"").lower().split()
HL = args.get("half_len_mm", 150) / FT


class LO(IFamilyLoadOptions):
    def OnFamilyFound(self, a, b):
        b.Value = True; return True

    def OnSharedFamilyFound(self, s, a, src, b):
        src.Value = FamilySource.Family; b.Value = True; return True


mul = wall = None
for w in FilteredElementCollector(doc).OfClass(Wall):
    if w.CurtainGrid is None: continue
    for mid in w.CurtainGrid.GetMullionIds():
        m = doc.GetElement(mid)
        nm = (m.Symbol.FamilyName + u" " + m.Name).lower()
        if all(k in nm for k in like) and m.LocationCurve is not None and abs(m.LocationCurve.Direction.Z) > 0.9:
            mul, wall = m, w; break
    if mul: break
res = {"mullion": mul.Name if mul else None, "files": [], "errors": []}
lc = wall.Location.Curve
d = lc.Direction; d = XYZ(d.X, d.Y, 0).Normalize(); n = XYZ(-d.Y, d.X, 0)
p0 = mul.LocationCurve.GetEndPoint(0); p1 = mul.LocationCurve.GetEndPoint(1)
zb, zt = min(p0.Z, p1.Z), max(p0.Z, p1.Z); zm = (zb + zt) / 2
org = XYZ(p0.X, p0.Y, zm)
lvl = sorted([l for l in FilteredElementCollector(doc).OfClass(Level) if l.Elevation <= zb + 1e-6], key=lambda l: -l.Elevation)
lvl = lvl[0] if lvl else sorted(FilteredElementCollector(doc).OfClass(Level), key=lambda l: l.Elevation)[0]
vft = lambda k: [v for v in FilteredElementCollector(doc).OfClass(ViewFamilyType) if v.ViewFamily == k][0]
solid = [fp for fp in FilteredElementCollector(doc).OfClass(FillPatternElement) if fp.GetFillPattern().IsSolidFill and fp.GetFillPattern().Target == FillPatternTarget.Drafting][0]


def hexc(h):
    h = h.lstrip("#"); return Color(int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))


def export(view, tag):
    o = ImageExportOptions()
    o.ExportRange = ExportRange.SetOfViews
    o.SetViewsAndSheets(List[ElementId]([view.Id]))
    o.FilePath = os.path.join(OUT, tag)
    o.ZoomType = ZoomFitType.FitToPage; o.PixelSize = args.get("px", 1400)
    o.HLRandWFViewsFileType = ImageFileType.PNG; o.ShadowViewsFileType = ImageFileType.PNG
    o.ImageResolution = ImageResolution.DPI_300
    before = set(glob.glob(os.path.join(OUT, tag + "*")))
    doc.ExportImage(o)
    new = [f for f in glob.glob(os.path.join(OUT, tag + "*")) if f not in before] or glob.glob(os.path.join(OUT, tag + "*"))
    if new:
        dst = os.path.join(OUT, tag + ".png")
        if new[0] != dst:
            if os.path.exists(dst): os.remove(dst)
            os.rename(new[0], dst)
        res["files"].append(dst)


def run(name, fn):
    t = Transaction(doc, name); t.Start()
    try:
        r = fn(); t.Commit(); return r
    except Exception as ex:
        t.RollBack(); res["errors"].append(name + ": " + str(ex)[:200]); return None


tg = TransactionGroup(doc, u"проба цвета (откат)"); tg.Start()
try:
    def mk_views():
        vp = ViewPlan.Create(doc, vft(ViewFamily.FloorPlan).Id, lvl.Id)
        vp.Name = u"_проба_цвет_план"
        vr = vp.GetViewRange()
        vr.SetLevelId(PlanViewPlane.TopClipPlane, lvl.Id); vr.SetOffset(PlanViewPlane.TopClipPlane, zt - lvl.Elevation + 1)
        vr.SetLevelId(PlanViewPlane.CutPlane, lvl.Id); vr.SetOffset(PlanViewPlane.CutPlane, zm - lvl.Elevation)
        vr.SetLevelId(PlanViewPlane.BottomClipPlane, lvl.Id); vr.SetOffset(PlanViewPlane.BottomClipPlane, 0)
        vr.SetLevelId(PlanViewPlane.ViewDepthPlane, lvl.Id); vr.SetOffset(PlanViewPlane.ViewDepthPlane, 0)
        vp.SetViewRange(vr)
        vp.Scale = args.get("scale", 2)
        bb = BoundingBoxXYZ()
        c = [org + d * HL + n * HL * 0.6, org - d * HL - n * HL * 0.6, org + d * HL - n * HL * 0.6, org - d * HL + n * HL * 0.6]
        bb.Min = XYZ(min(p.X for p in c), min(p.Y for p in c), lvl.Elevation - 1); bb.Max = XYZ(max(p.X for p in c), max(p.Y for p in c), zt + 1)
        vp.CropBoxActive = True; vp.CropBox = bb; vp.CropBoxVisible = False
        v3 = View3D.CreateIsometric(doc, vft(ViewFamily.ThreeDimensional).Id)
        v3.Name = u"_проба_цвет_3D"
        sb = BoundingBoxXYZ()
        tr = Transform.Identity; tr.Origin = org; tr.BasisX = d; tr.BasisY = n; tr.BasisZ = XYZ.BasisZ
        sb.Transform = tr
        sb.Min = XYZ(-HL, -HL * 0.6, -HL * 1.2); sb.Max = XYZ(HL, HL * 0.6, 0)
        v3.SetSectionBox(sb)
        eye = org + d * (-1.0) + n * (-1.0) + XYZ.BasisZ * 1.2
        fwd = (org - eye).Normalize()
        up = XYZ.BasisZ.Subtract(fwd.Multiply(XYZ.BasisZ.DotProduct(fwd))).Normalize()
        v3.SetOrientation(ViewOrientation3D(eye, up, fwd))
        v3.DetailLevel = ViewDetailLevel.Fine
        v3.Scale = args.get("scale3d", 2)   # мелкий масштаб = тонкие линии относительно узла
        try:
            v3.get_Parameter(BuiltInParameter.MODEL_GRAPHICS_STYLE_ANON_DRAFT)  # no-op
        except Exception:
            pass
        return vp.Id, v3.Id
    ids = run(u"виды", mk_views)
    vp = doc.GetElement(ids[0]); v3 = doc.GetElement(ids[1])
    try:
        v3.get_Parameter(BuiltInParameter.VIEWER_ANNOTATION_CROP_ACTIVE)
    except Exception:
        pass

    def shots(prefix):
        only = args.get("only")
        plans = ((ViewDetailLevel.Coarse, "plan_coarse"), (ViewDetailLevel.Medium, "plan_medium"), (ViewDetailLevel.Fine, "plan_fine"))
        for dl, tg_ in ([] if only == "3d" else plans):
            run(u"детализация", lambda: setattr(vp, "DetailLevel", dl))
            try: export(vp, prefix + "_" + tg_)
            except Exception as ex: res["errors"].append("export " + tg_ + ": " + str(ex)[:160])
        sty = ((DisplayStyle.HLR, "3d_hidden"), (DisplayStyle.ShadingWithEdges, "3d_shaded"), (DisplayStyle.Realistic, "3d_realistic"))
        for ds, tg_ in [s for s in sty if not args.get("styles") or s[1] in args["styles"]]:
            run(u"стиль", lambda: setattr(v3, "DisplayStyle", ds))
            try: export(v3, prefix + "_" + tg_)
            except Exception as ex: res["errors"].append("export " + tg_ + ": " + str(ex)[:160])

    shots("before")

    def apply_after():
        for p in args.get("rfas", []):
            fam = clr_ref = None
            ok = doc.LoadFamily(p, LO())
            res.setdefault("loaded", []).append([os.path.basename(p), bool(ok)])
        mats = dict((m.Name, m) for m in FilteredElementCollector(doc).OfClass(Material))
        for nm, spec in args.get("materials", {}).items():
            m = mats.get(nm)
            if m is None:
                res["errors"].append(u"нет материала " + nm); continue
            if spec.get("shade"):
                m.Color = hexc(spec["shade"]); m.UseRenderAppearanceForShading = False
            if spec.get("cut"):
                m.CutForegroundPatternId = solid.Id; m.CutForegroundPatternColor = hexc(spec["cut"])
            if spec.get("transp") is not None:
                m.Transparency = int(spec["transp"])
            if spec.get("appearance"):
                # внешний вид (Реалистичный): свойства ассета, напр. common_Tint_toggle, glazing_transmittance_color
                from Autodesk.Revit.DB.Visual import AppearanceAssetEditScope, AssetPropertyBoolean, AssetPropertyInteger, AssetPropertyDouble, AssetPropertyDoubleArray4d
                with AppearanceAssetEditScope(doc) as es:
                    ea = es.Start(m.AppearanceAssetId); log = {}
                    for k, v in spec["appearance"].items():
                        p = ea.FindByName(k)
                        if p is None:
                            log[k] = u"нет свойства"; continue
                        old = None
                        if isinstance(p, AssetPropertyBoolean): old = p.Value; p.Value = bool(v)
                        elif isinstance(p, AssetPropertyInteger): old = p.Value; p.Value = int(v)
                        elif isinstance(p, AssetPropertyDouble): old = p.Value; p.Value = float(v)
                        elif isinstance(p, AssetPropertyDoubleArray4d):
                            old = list(p.GetValueAsDoubles()); p.SetValueAsDoubles(List[float]([float(x) for x in v]))
                        log[k] = [old, v]
                    es.Commit(True)
                    res.setdefault("appearance", {})[nm] = log
    run(u"цвет: стало", apply_after)
    shots("after")
finally:
    tg.RollBack()
    res["rolled_back"] = True
__output__ = {"status": "partial" if res["errors"] else "completed_unverified", "summary": u"проба цвета с откатом: %d картинок" % len(res["files"]), "result": res}
