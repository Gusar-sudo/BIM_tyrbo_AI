            it.update(title=u"секция с одинарным остеклением", wall_type=W[s] % u"Одинарное")
        elif kind == u"двойное":
            it.update(title=u"секция с двойным остеклением", wall_type=W[s] % u"Двойное")
        else:
            it.update(title=u"комбинированная: стекло ниже ригеля, ГКЛ выше", wall_type=W[s] % u"Одинарное",
                      panel_below=S1[s], panel_above=G[s],
                      zone_types={u"transom": B(u"центральный стекло + ГКЛ с однослойным остеклением, ГКЛ справа"),
