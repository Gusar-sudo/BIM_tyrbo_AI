def new_page(title, sub=None):
    p = Image.new("RGB", (W, H), "white"); d = ImageDraw.Draw(p)
    d.text((80, 50), title, fill="black", font=FB(54))
    if sub:
        d.text((80, 125), sub, fill=(90, 90, 90), font=F(30))
    d.line([(80, 180), (W - 80, 180)], fill=(160, 160, 160), width=3)
    d.text((W - 640, H - 70), "Фристайл · М2 · test_M2M3_seals · 30.10.2026", fill=(150, 150, 150), font=F(26))
    d.text((80, H - 70), "стр. %d" % (len(pages) + 1), fill=(150, 150, 150), font=F(26))
    return p, d


def crop_content(im, pad=30):
    g = im.convert("L").point(lambda v: 255 if v < 245 else 0)
    bb = g.getbbox()
    return im.crop((max(0, bb[0] - pad), max(0, bb[1] - pad), min(im.width, bb[2] + pad), min(im.height, bb[3] + pad))) if bb else im


def fit(im, w, h):
    im = im.copy(); im.thumbnail((w, h), Image.LANCZOS); return im


def one(pattern):
    f = glob.glob(os.path.join(src, pattern))
    return f[0] if f else None


def cell(p, d, f, x, y, w, h, label, crop=True):
    d.rectangle([x, y, x + w, y + h], outline=(190, 190, 190), width=2)
    d.text((x + 14, y + 10), label, fill=(170, 0, 0), font=FB(28))
    if f is None:
        d.text((x + 20, y + 60), "нет вида", fill=(200, 0, 0), font=F(28)); return
    im = Image.open(f).convert("RGB")
    if crop == "center":
        # центральная часть вида: узел крупно, без посторонних элементов модели по краям
        k = 0.62; cw0, ch0 = im.width * k, im.height * k
        im = im.crop((int((im.width - cw0) / 2), int((im.height - ch0) / 2), int((im.width + cw0) / 2), int((im.height + ch0) / 2)))
    elif crop:
        im = crop_content(im)
    im = fit(im, w - 20, h - 60)
    p.paste(im, (x + (w - im.width) // 2, y + 50 + (h - 50 - im.height) // 2))


def page(title, sub, album, cells, ncol, album_w=1050):
    p, d = new_page(title, sub)
    top, bot = 210, H - 100
    if album:
        cell(p, d, os.path.join(alb, album[0]), 80, top, album_w, bot - top, "Альбом: " + album[1], crop=False)
        x0 = 80 + album_w + 40
    else:
        x0 = 80
    nrow = (len(cells) + ncol - 1) // ncol
    cw = (W - 80 - x0 - (ncol - 1) * 25) // ncol; ch = (bot - top - (nrow - 1) * 25) // nrow
    for i, (f, lab, cr) in enumerate(cells):
        cell(p, d, f, x0 + (i % ncol) * (cw + 25), top + (i // ncol) * (ch + 25), cw, ch, lab, crop=cr)
    pages.append(p)


