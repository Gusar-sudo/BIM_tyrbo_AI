def vpage(tag, title, album, has_rigel=True):
    nodes = ["потолок", "ригель", "пол"] if has_rigel else ["потолок", "пол"]
    cells = []
    for c in (1, 2):
        lo, hi = GL[c]
        for nm in nodes:
            g = {"потолок": hi, "ригель": hi + " / " + lo, "пол": lo}[nm] if has_rigel else "—"
            lab = "Колонка %d · %s" % (c, nm) + ("" if not has_rigel else " · стекло %s мм" % g)
            cells.append((one("V_%s_c%d_%s*.png" % (tag, c, nm)), lab, "center"))
    # раскладка: столбцы = колонки панелей, строки = узлы сверху вниз
    order = []
    for r in range(len(nodes)):
        for c in range(2):
            order.append(cells[c * len(nodes) + r])
    page(title, "Вертикальные разрезы через середину колонок панелей; фасад (стекло) — слева. Сверху вниз: потолок → ригель → пол.", album, order, 2)


