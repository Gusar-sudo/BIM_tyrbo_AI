def hpage(tags, title):
    cells = []
    for tag, hz in tags:
        fs = sorted(glob.glob(os.path.join(src, "H_%s_%04d_*.png" % (tag, hz))))
        for f in fs:
            nm = os.path.basename(f).split(" · ")[-1][:-4]
            for a, b in (("М2 ", ""), (" с однослойным остеклением", ""), (" с двухслойным остеклением", ""),
                         (" с двухслойным цельностеклянным остеклением", ""), ("примыкание к ", "к "), (" центральный", " центр")):
                nm = nm.replace(a, b)
            g = {500: "5|6", 1500: "8|10", 1000: "цс"}[hz]
            cells.append((f, "%s · %s · %s" % (tag, g, nm), "center"))
    page(title, "Горизонтальные сечения (план) 1:2. Фасад (стекло) — снизу. Слева — рис. 36 альбома.", ("36_гориз_сечение.png", "рис. 36"), cells, 3, album_w=950)


