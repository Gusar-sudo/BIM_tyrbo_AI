# -*- coding: utf-8 -*-
# Пробный прогон/применение: загрузить профили (args_strip items[].rfa) и снять виды «до» и «после» по префиксу/фильтру имени.
# Аргументы: args_strip, view_prefix, view_contains, out_dir, commit
import json, os, clr
from System.Collections.Generic import List
from Autodesk.Revit.DB import *
args = json.loads(HORIZUN_ARGS_JSON)
doc = __revit__.ActiveUIDocument.Document
commit = bool(args.get("commit", False))


class LoadOpt(IFamilyLoadOptions):
    def OnFamilyFound(self, a, o):
        o.Value = False; return True

    def OnSharedFamilyFound(self, s, a, src, o):
        src.Value = FamilySource.Family; o.Value = False; return True


def counts():
    return {"mullions": FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_CurtainWallMullions).WhereElementIsNotElementType().GetElementCount(),
            "panels": FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_CurtainWallPanels).WhereElementIsNotElementType().GetElementCount(),
            "warnings": len(doc.GetWarnings())}


views = [v for v in FilteredElementCollector(doc).OfClass(View) if not v.IsTemplate and v.Name.startswith(args.get("view_prefix", u""))
         and all(s in v.Name for s in args.get("view_contains", []))]


def shoot(tag):
    for v in views:
        o = ImageExportOptions(); o.ExportRange = ExportRange.SetOfViews
        ids = List[ElementId](); ids.Add(v.Id); o.SetViewsAndSheets(ids)
        o.ZoomType = ZoomFitType.FitToPage; o.PixelSize = 900; o.ImageResolution = ImageResolution.DPI_300
        o.HLRandWFViewsFileType = ImageFileType.PNG
        o.FilePath = os.path.join(args["out_dir"], u"%s_%d" % (tag, int(v.Id.Value)))
        doc.ExportImage(o)


if not os.path.isdir(args["out_dir"]):
    os.makedirs(args["out_dir"])
res = {"before": counts(), "views": [v.Name for v in views], "errors": []}
if args.get("shoot_before", True):
    shoot("a_before")
tg = TransactionGroup(doc, u"FT: профили сложных столбов без U5"); tg.Start()
try:
    with open(args["args_strip"], encoding="utf-8") as f:
        items = json.load(f)["items"]
    t = Transaction(doc, u"FT: загрузка профилей"); t.Start()
    n = sum(1 for it in items if doc.LoadFamily(it["rfa"], LoadOpt(), clr.Reference[Family]()))
    t.Commit()
    res["loaded"] = [n, len(items)]
    res["after"] = counts()
    res["new_warnings"] = [w.GetDescriptionText()[:120] for w in doc.GetWarnings()][:8]
    shoot("b_after")
except Exception as ex:
    res["errors"].append(str(ex)[:300])
finally:
    if commit and not res["errors"]:
        tg.Assimilate()
    else:
        tg.RollBack()
res["committed"] = commit and not res["errors"]
__output__ = {"status": "completed_unverified", "summary": u"%s; профилей %s, видов %d" % (u"применено" if res["committed"] else u"откат", res.get("loaded"), len(views)), "result": res}
