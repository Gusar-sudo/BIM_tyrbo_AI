# 2–5. листы прямых узлов
sheets = [("01_М2_1сл_FSC21.png", "Прямые узлы · М2 однослойное · стойка FSC21"),
          ("02_М2_2сл_FSC21.png", "Прямые узлы · М2 двухслойное · стойка FSC21"),
          ("05_М2_1сл_FSC21_FSC17.png", "Прямые узлы · М2 однослойное · столб FSC17 в середине"),
          ("06_М2_2сл_FSC21_FSC17.png", "Прямые узлы · М2 двухслойное · столб FSC17 в середине")]
for fn, title in sheets:
    p, d = new_page(title, "Верхний ряд — сечение 500 мм (стекло 5 | 6 мм, U5 | U6); нижний — 1500 мм (стекло 8 | 10 мм, U8 | U10). Фасад — снизу.")
    im = Image.open(os.path.join(base, "sheets", fn)).convert("RGB")
    im = im.crop((0, 70, im.width, im.height))          # без собственного заголовка листа
    im = fit(im, W - 160, H - 300)
    p.paste(im, ((W - im.width) // 2, 210))
    pages.append(p)

# 6–7. углы и Т-узлы
sch = sorted(glob.glob(os.path.join(base, "M2_review", "v*.png")))
def find(code):
    return [f for f in sch if ("Схема " + code + " ") in f][0]
groups = [("Углы · М2 однослойное", ["01", "02", "03"]),
          ("Углы и Т-узлы · М2 двухслойное", ["04", "06", "07", "05", "08"])]
for title, codes in groups:
    p, d = new_page(title, "Стена A — слева (горизонтальная, фасад снизу), стена B уходит вверх / под 45°. Стекло 5 мм, уплотнитель U5.")
    n = len(codes); cols = 3; rows = (n + cols - 1) // cols
    cw = (W - 160 - (cols - 1) * 40) // cols; ch = (H - 300 - (rows - 1) * 40) // rows
    for i, c in enumerate(codes):
        f = find(c)
        name = os.path.basename(f).split(" - ")[-1][:-4].replace("Схема ", "")
        im = fit(crop_content(Image.open(f).convert("RGB"), 60), cw - 20, ch - 70)
        x = 80 + (i % cols) * (cw + 40); yy = 210 + (i // cols) * (ch + 40)
        d.rectangle([x, yy, x + cw, yy + ch], outline=(180, 180, 180), width=2)
        d.text((x + 15, yy + 12), name, fill=(170, 0, 0), font=FB(34))
        p.paste(im, (x + (cw - im.width) // 2, yy + 60 + (ch - 70 - im.height) // 2))
    pages.append(p)

pages[0].save(out_pdf, save_all=True, append_images=pages[1:], resolution=200)
for i, pg in enumerate(pages):
    pg.resize((W // 2, H // 2)).save(os.path.join(base, "M2_review", "page_%02d.png" % (i + 1)))
print(out_pdf, len(pages))
