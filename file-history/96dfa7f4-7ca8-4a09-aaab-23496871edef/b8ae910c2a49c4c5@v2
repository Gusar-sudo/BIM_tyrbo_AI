# Пакет визуальной проверки М2: PDF (A3 альбомный, 200 dpi) из листов узлов и схем углов/Т.
import glob, os, sys
from PIL import Image, ImageDraw, ImageFont
base = r"C:\Users\user\Desktop\Фристайл\_bim\test\2026-10-28_M2M3_seals"
out_pdf = os.path.join(base, "M2_review", "М2_визуальная_проверка_2026-10-30.pdf")
W, H = 3307, 2339   # A3 landscape @200 dpi
F = lambda s: ImageFont.truetype(r"C:\Windows\Fonts\arial.ttf", s)
FB = lambda s: ImageFont.truetype(r"C:\Windows\Fonts\arialbd.ttf", s)
pages = []


def new_page(title, sub=None):
    p = Image.new("RGB", (W, H), "white"); d = ImageDraw.Draw(p)
    d.text((80, 50), title, fill="black", font=FB(54))
    if sub:
        d.text((80, 125), sub, fill=(90, 90, 90), font=F(32))
    d.line([(80, 180), (W - 80, 180)], fill=(160, 160, 160), width=3)
    d.text((W - 620, H - 70), "Фристайл · М2 · test_M2M3_seals · 30.10.2026", fill=(150, 150, 150), font=F(26))
    d.text((80, H - 70), "стр. %d" % (len(pages) + 1), fill=(150, 150, 150), font=F(26))
    return p, d


def crop_content(im, pad=40):
    g = im.convert("L").point(lambda v: 255 if v < 245 else 0)
    bb = g.getbbox()
    if not bb:
        return im
    return im.crop((max(0, bb[0] - pad), max(0, bb[1] - pad), min(im.width, bb[2] + pad), min(im.height, bb[3] + pad)))


def fit(im, w, h):
    im = im.copy(); im.thumbnail((w, h), Image.LANCZOS); return im


# 1. титул и легенда
