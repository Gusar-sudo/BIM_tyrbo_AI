# Подготовка контуров уплотнителей U5/U6/U8/U10 из seal_contours.json (снятых с «Уплотнители в перегородку.dwg»)
# для профилей Revit: замкнутый контур, отрезки не короче MIN_SEG (Revit не строит линии короче ~0,8 мм),
# без самопересечений. Координаты, мм: x — от кромки стекла внутрь стекла, y — от лицевой грани стекла (минус — вглубь стены).
# Выход: seal_profiles.json + картинка сравнения.
import json, math, sys
src, out_json, out_png = sys.argv[1], sys.argv[2], sys.argv[3]
MIN_SEG = 0.9
data = json.load(open(src, encoding="utf-8"))
pick = {"U5": ("LWPOLYLINE", "Основная"), "U6": ("HATCH", "0"), "U8": ("HATCH", "0"), "U10": ("LWPOLYLINE", "0")}


def dedupe(pts):
    out = []
    for p in pts:
        if not out or math.dist(p, out[-1]) > 1e-3:
            out.append(tuple(p))
    if math.dist(out[0], out[-1]) < 1e-3:
        out.pop()
    return out


def area(pts):
    return 0.5 * sum(pts[i][0] * pts[(i + 1) % len(pts)][1] - pts[(i + 1) % len(pts)][0] * pts[i][1] for i in range(len(pts)))


def dp(pts, tol):
    if len(pts) < 3:
        return pts
    a, b = pts[0], pts[-1]
    dx, dy = b[0] - a[0], b[1] - a[1]
    L = math.hypot(dx, dy) or 1e-9
    dmax, idx = 0, 0
    for i in range(1, len(pts) - 1):
        d = abs(dy * pts[i][0] - dx * pts[i][1] + b[0] * a[1] - b[1] * a[0]) / L
        if d > dmax:
            dmax, idx = d, i
    if dmax > tol:
        return dp(pts[:idx + 1], tol)[:-1] + dp(pts[idx:], tol)
    return [a, b]


def dp_closed(pts, tol):
    # разрезать по самой дальней от первой точки
    i = max(range(len(pts)), key=lambda k: math.dist(pts[0], pts[k]))
    a = dp(pts[:i + 1], tol); b = dp(pts[i:] + [pts[0]], tol)
    return a[:-1] + b[:-1]


def seg_inter(p1, p2, p3, p4):
    def ccw(a, b, c):
        return (c[1] - a[1]) * (b[0] - a[0]) - (b[1] - a[1]) * (c[0] - a[0])
    d1, d2, d3, d4 = ccw(p3, p4, p1), ccw(p3, p4, p2), ccw(p1, p2, p3), ccw(p1, p2, p4)
    return (d1 * d2 < 0) and (d3 * d4 < 0)


def self_inter(pts):
    n = len(pts)
    for i in range(n):
        for j in range(i + 2, n):
            if i == 0 and j == n - 1:
                continue
            if seg_inter(pts[i], pts[(i + 1) % n], pts[j], pts[(j + 1) % n]):
                return True
    return False


def merge_short(pts):
    pts = list(pts)
    changed = True
    while changed and len(pts) > 4:
        changed = False
        n = len(pts)
        best = None
        for i in range(n):
            if math.dist(pts[i], pts[(i + 1) % n]) < MIN_SEG:
                # убрать одну из двух вершин короткого отрезка — ту, что меньше меняет площадь
                for k in (i, (i + 1) % n):
                    trial = pts[:k] + pts[k + 1:]
                    da = abs(area(trial) - area(pts))
                    if best is None or da < best[0]:
                        best = (da, k)
                break
        if best is not None:
            trial = pts[:best[1]] + pts[best[1] + 1:]
            if not self_inter(trial):
                pts = trial; changed = True
            else:
                # другая вершина
                i = best[1]
                alt = (i + 1) % len(pts) if True else i
                trial = pts[:alt] + pts[alt + 1:]
                pts = trial; changed = True
    return pts


res = {}
for name, (t, layer) in pick.items():
    cand = [it for it in data[name] if it["t"] == t and it["layer"] == layer and it["n"] > 20]
    raw = dedupe(cand[0]["pts"])
    s = merge_short(dp_closed(raw, 0.06))
    if area(s) < 0:
        s = s[::-1]
    mins = min(math.dist(s[i], s[(i + 1) % len(s)]) for i in range(len(s)))
    res[name] = {"raw_n": len(raw), "n": len(s), "min_seg": round(mins, 3), "self_inter": self_inter(s),
                 "area_raw": round(abs(area(raw)), 2), "area": round(abs(area(s)), 2),
                 "bbox": [round(min(p[0] for p in s), 2), round(min(p[1] for p in s), 2), round(max(p[0] for p in s), 2), round(max(p[1] for p in s), 2)],
                 "pts": [[round(p[0], 3), round(p[1], 3)] for p in s], "raw": raw}
json.dump({k: {kk: vv for kk, vv in v.items() if kk != "raw"} for k, v in res.items()}, open(out_json, "w", encoding="utf-8"), ensure_ascii=False)
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
fig, axs = plt.subplots(1, 4, figsize=(16, 5))
for ax, (name, v) in zip(axs, res.items()):
    t = {"U5": 5, "U6": 6, "U8": 8, "U10": 10}[name]
    ax.fill_between([-2, 14], -t, 0, color="#cde", label="стекло %d" % t)
    rx = [p[0] for p in v["raw"]] + [v["raw"][0][0]]; ry = [p[1] for p in v["raw"]] + [v["raw"][0][1]]
    ax.plot(rx, ry, color="#bbb", lw=3, label="DWG")
    sx = [p[0] for p in v["pts"]] + [v["pts"][0][0]]; sy = [p[1] for p in v["pts"]] + [v["pts"][0][1]]
    ax.plot(sx, sy, "k.-", lw=1, ms=3, label="Revit %d точек" % v["n"])
    ax.axvline(0, color="r", lw=0.8)
    ax.set_title("%s  мин. отрезок %.2f мм" % (name, v["min_seg"]))
    ax.set_aspect("equal"); ax.set_xlim(-2, 14); ax.set_ylim(-17, 1); ax.grid(alpha=0.3)
    ax.legend(fontsize=7, loc="lower right")
plt.tight_layout(); plt.savefig(out_png, dpi=130)
for k, v in res.items():
    print(k, {kk: vv for kk, vv in v.items() if kk not in ("pts", "raw")})
