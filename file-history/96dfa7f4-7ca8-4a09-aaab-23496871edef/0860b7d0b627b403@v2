import os, re
from PIL import Image, ImageDraw, ImageFont
base = r"C:\Users\user\Desktop\Фристайл\_bim\test\2026-10-28_M2M3_seals\types_review"
src = os.path.join(base, "schemes_all")
out_pdf = os.path.join(base, "М2_М3_все_углы_и_Т_2026-11-02.pdf")
W, H = 3307, 2339
F = lambda s: ImageFont.truetype(r"C:\Windows\Fonts\arial.ttf", s)
FB = lambda s: ImageFont.truetype(r"C:\Windows\Fonts\arialbd.ttf", s)
files = {}
for f in os.listdir(src):
    m = re.match(r"s_Все (\d\d) (.*)\.png$", f)
    if m:
        files[int(m.group(1))] = (m.group(2).split(" - ")[0], os.path.join(src, f))
pages = []


def center(im, k):
    cw, ch = im.width * k, im.height * k
    return im.crop((int((im.width - cw) / 2), int((im.height - ch) / 2), int((im.width + cw) / 2), int((im.height + ch) / 2)))


def page(title, sub, items, ncol=4, nrow=2, k=0.62):
    p = Image.new("RGB", (W, H), "white"); d = ImageDraw.Draw(p)
    d.text((80, 50), title, fill="black", font=FB(52)); d.text((80, 122), sub, fill=(90, 90, 90), font=F(30))
    d.line([(80, 175), (W - 80, 175)], fill=(160, 160, 160), width=3)
    d.text((80, H - 70), "стр. %d" % (len(pages) + 1), fill=(150, 150, 150), font=F(26))
    d.text((W - 700, H - 70), "Фристайл · М2/М3 · test_M2M3_seals · 02.11.2026", fill=(150, 150, 150), font=F(26))
    top, bot = 200, H - 100
    nrow = (len(items) + ncol - 1) // ncol
    cw = (W - 160 - (ncol - 1) * 20) // ncol; chh = min((bot - top - (nrow - 1) * 20) // nrow, cw + 60)
    for i, n in enumerate(items):
        name, f = files[n]
        x = 80 + (i % ncol) * (cw + 20); y = top + (i // ncol) * (chh + 20)
        d.rectangle([x, y, x + cw, y + chh], outline=(190, 190, 190), width=2)
        d.text((x + 12, y + 10), name, fill=(170, 0, 0), font=FB(30))
        im = center(Image.open(f).convert("RGB"), k); im.thumbnail((cw - 16, chh - 56), Image.LANCZOS)
        p.paste(im, (x + (cw - im.width) // 2, y + 50 + (chh - 56 - im.height) // 2))
    pages.append(p)


