# -*- coding: utf-8 -*-
# Без изменения модели: в группе транзакций подменить тип импоста-образца на каждый из списка,
# снять план-сечение (Fine, 1:2) вокруг него и откатить всё (RollBack).
# Аргументы: jobs [{mullion_id, types:[имя типа импоста]}], out_dir, half_mm, px
import json, os, clr
from System.Collections.Generic import List
from Autodesk.Revit.DB import *
args = json.loads(HORIZUN_ARGS_JSON)
doc = __revit__.ActiveUIDocument.Document
FT = 304.8
H = float(args.get("half_mm", 170)) / FT
vft = [t for t in FilteredElementCollector(doc).OfClass(ViewFamilyType) if t.ViewFamily == ViewFamily.FloorPlan][0]
mtypes = dict((mt.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM).AsString(), mt) for mt in FilteredElementCollector(doc).OfClass(MullionType))
files, errs = [], []
class LoadOpt(IFamilyLoadOptions):
    def OnFamilyFound(self, familyInUse, overwriteParameterValues):
        overwriteParameterValues.Value = False
        return True

    def OnSharedFamilyFound(self, sharedFamily, familyInUse, source, overwriteParameterValues):
        source.Value = FamilySource.Family
        overwriteParameterValues.Value = False
        return True


tg = TransactionGroup(doc, u"снимки типов столбов (откат)")
tg.Start()
loaded = []
try:
    # пробная загрузка исправленных профилей (args.preload_rfas) — тоже откатывается вместе с группой
    if args.get("preload_rfas"):
        t = Transaction(doc, u"пробная загрузка"); t.Start()
        for rfa in args["preload_rfas"]:
            fam = clr.Reference[Family]()
            ok = doc.LoadFamily(rfa, LoadOpt(), fam)
            loaded.append([os.path.basename(rfa), bool(ok)])
        t.Commit()
    k = 0
    for job in args["jobs"]:
        m = doc.GetElement(ElementId(int(job["mullion_id"])))
        w = m.Host
        lvl = doc.GetElement(w.LevelId)
        for tn in job["types"]:
            k += 1
            if tn not in mtypes:
                errs.append(u"нет типа " + tn); continue
            t = Transaction(doc, u"подмена"); t.Start()
            fo = t.GetFailureHandlingOptions(); t.SetFailureHandlingOptions(fo)
            m.ChangeTypeId(mtypes[tn].Id)
            doc.Regenerate()
            bb = m.get_BoundingBox(None)
            c = (bb.Min + bb.Max) * 0.5
            v = ViewPlan.Create(doc, vft.Id, w.LevelId)
            v.Name = u"SNAP_%02d" % k
            v.Scale = 2; v.DetailLevel = ViewDetailLevel.Fine
            vr = v.GetViewRange(); vr.SetOffset(PlanViewPlane.CutPlane, 500.0 / FT); v.SetViewRange(vr)
            box = BoundingBoxXYZ(); box.Min = XYZ(c.X - H, c.Y - H, -1000); box.Max = XYZ(c.X + H, c.Y + H, 1000)
            v.CropBox = box; v.CropBoxActive = True; v.CropBoxVisible = False
            t.Commit()
            o = ImageExportOptions(); o.ExportRange = ExportRange.SetOfViews
            ids = List[ElementId](); ids.Add(v.Id); o.SetViewsAndSheets(ids)
            o.ZoomType = ZoomFitType.FitToPage; o.PixelSize = int(args.get("px", 800))
            o.ImageResolution = ImageResolution.DPI_300; o.HLRandWFViewsFileType = ImageFileType.PNG
            o.FilePath = os.path.join(args["out_dir"], args.get("prefix", u"t") + u"%02d" % k)
            doc.ExportImage(o)
            files.append({"k": k, "type": tn})
finally:
    tg.RollBack()
__output__ = {"status": "completed_unverified", "summary": u"%d снимков, всё откатано" % len(files), "files": files, "errors": errs, "preloaded": loaded}
