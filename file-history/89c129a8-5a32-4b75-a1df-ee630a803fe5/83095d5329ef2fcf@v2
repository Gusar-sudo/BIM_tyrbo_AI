import sys
path = sys.argv[1]
try:
    from pypdf import PdfReader
except ImportError:
    try:
        from PyPDF2 import PdfReader
    except ImportError:
        try:
            import fitz
            doc = fitz.open(path)
            sys.stdout.reconfigure(encoding="utf-8")
            for i, p in enumerate(doc):
                print(f"--- page {i+1} ---")
                print(p.get_text())
            sys.exit(0)
        except ImportError:
            print("NO_PDF_LIB")
            sys.exit(2)
sys.stdout.reconfigure(encoding="utf-8")
r = PdfReader(path)
for i, p in enumerate(r.pages):
    print(f"--- page {i+1} ---")
    print(p.extract_text())
